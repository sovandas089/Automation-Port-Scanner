#!/bin/bash
# ─────────────────────────────────────────────
#  Parallel UDP Nmap Scanner v2.1
#  T1046 — Network Service Discovery
#  Fixed: color codes, progress bar, cursor redraw
# ─────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Root check ────────────────────────────────
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[!] UDP scanning requires root. Run with sudo.${NC}"
    exit 1
fi

# ── IP input ──────────────────────────────────
if [[ -n "$1" ]]; then
    TARGET="$1"
else
    echo -e "${CYAN}${BOLD}"
    echo "  ╔════════════════════════════════════════╗"
    echo "  ║    Parallel UDP Nmap Scanner v2.1      ║"
    echo "  ║    T1046 — Network Service Discovery   ║"
    echo "  ╚════════════════════════════════════════╝"
    echo -e "${NC}"
    read -rp "  Enter target IP: " TARGET
fi

# ── Validate IP ───────────────────────────────
if ! [[ "$TARGET" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    echo -e "${RED}[!] Invalid IP address: $TARGET${NC}"
    exit 1
fi

# ── Setup output dir ──────────────────────────
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
OUTDIR="udp_scan_${TARGET//./_}_${TIMESTAMP}"
mkdir -p "$OUTDIR"
FINAL_OUT="$OUTDIR/UDP_FULL_SCAN_${TARGET//./_}.txt"
OPEN_PORTS_FILE="$OUTDIR/udp_open_ports.txt"
PROGRESS_DIR="$OUTDIR/.progress"
mkdir -p "$PROGRESS_DIR"

RANGES=("1-16383" "16384-32767" "32768-49151" "49152-65535")
START_EPOCH=$(date +%s)

echo -e "\n${GREEN}${BOLD}[+] Target     : $TARGET${NC}"
echo -e "${GREEN}[+] Output dir : $OUTDIR${NC}"
echo -e "${GREEN}[+] Started    : $(date)${NC}"
echo -e "${YELLOW}[!] UDP scanning is slow — 4 parallel jobs reduce total time${NC}\n"

# ── draw_bar: fill% out of 20 chars ──────────
draw_bar() {
    local pct=$1 width=20
    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    local bar=""
    for ((i=0; i<filled; i++)); do bar+="█"; done
    for ((i=0; i<empty; i++)); do bar+="░"; done
    printf "%s" "$bar"
}

# ── elapsed: mm:ss since START_EPOCH ─────────
elapsed() {
    local s=$(( $(date +%s) - START_EPOCH ))
    printf "%02dm%02ds" $(( s/60 )) $(( s%60 ))
}

# ── Phase 1: Priority UDP ports ───────────────
PRIORITY_PORTS="53,67,68,69,111,123,137,138,139,161,162,177,389,427,443,445,500,514,520,623,626,631,1194,1434,1900,4500,5353,5683"
P_COUNT=$(echo "$PRIORITY_PORTS" | tr ',' '\n' | wc -l)

echo -e "${YELLOW}${BOLD}[*] Phase 1 — Priority UDP ports (fast)${NC}"
echo -e "${DIM}    $P_COUNT ports: DNS,SNMP,IKE,NTP,TFTP,SSDP...${NC}\n"

P1_START=$(date +%s)
nmap -sU -Pn -T4 --max-retries 1 --max-rate 200 \
  -p "$PRIORITY_PORTS" \
  --script banner,dns-recursion,snmp-info,snmp-sysdescr,ike-version,ntp-info,tftp-enum,nbstat \
  "$TARGET" -oN "$OUTDIR/priority_udp.txt" > /dev/null 2>&1 &
P1_PID=$!

# Simple spinner for phase 1
SPIN=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
SI=0
while kill -0 "$P1_PID" 2>/dev/null; do
    printf "\r  \033[0;36m%s\033[0m Priority scan running... | $(elapsed) elapsed  " "${SPIN[$SI]}"
    SI=$(( (SI+1) % 10 ))
    sleep 0.2
done
wait "$P1_PID"
P1_DUR=$(( $(date +%s) - P1_START ))
printf "\r  \033[0;32m✓\033[0m Priority scan done | %ds                    \n\n" "$P1_DUR"

QUICK_OPEN=$(grep "^[0-9]" "$OUTDIR/priority_udp.txt" 2>/dev/null | grep "/open " | awk '{print $1}' | tr '\n' ' ')
[[ -n "$QUICK_OPEN" ]] && echo -e "  ${GREEN}[!] Quick finds: $QUICK_OPEN${NC}\n"

# ── Phase 2: Parallel full UDP scan ───────────
echo -e "${YELLOW}${BOLD}[*] Phase 2 — Full UDP scan (1-65535) — 4 parallel jobs${NC}"
echo -e "${DIM}    Rate: 150 pkts/s | max-retries: 1 | ~16383 ports each${NC}\n"

# Print 7 blank lines that the redraw loop will overwrite
for i in $(seq 7); do echo ""; done

for i in 1 2 3 4; do
    nmap -sU -Pn -T4 -v \
      -p "${RANGES[$((i-1))]}" \
      --max-rate 150 --max-retries 1 \
      "$TARGET" \
      -oN "$OUTDIR/udp_part${i}.txt" \
      > "$PROGRESS_DIR/log${i}.txt" 2>&1 &
    eval "PID${i}=$!"
done
PIDS=($PID1 $PID2 $PID3 $PID4)
DONE_TIMES=("" "" "" "")

# ── Progress redraw loop ──────────────────────
while true; do
    ALL_DONE=1
    TOTAL_PCT=0
    NOW=$(date +%s)
    ELAPSED_S=$(( NOW - START_EPOCH ))

    # Move cursor up 7 lines to overwrite
    printf "\033[7A"

    # Header line
    printf "\033[2K  \033[1m\033[0;36mJob Progress:\033[0m\n"

    for i in 0 1 2 3; do
        JN=$(( i+1 ))
        PID="${PIDS[$i]}"
        RANGE="${RANGES[$i]}"

        if kill -0 "$PID" 2>/dev/null; then
            ALL_DONE=0
            RAW=$(grep -oP 'About \K[0-9.]+(?=% done)' \
              "$PROGRESS_DIR/log${JN}.txt" 2>/dev/null | tail -1)
            PCT=$(printf "%.0f" "${RAW:-0}")
            [[ $PCT -gt 100 ]] && PCT=100
            STATUS="\033[0;36mscanning\033[0m"
            TSTR=""
        else
            PCT=100
            STATUS="\033[0;32mdone    \033[0m"
            if [[ -z "${DONE_TIMES[$i]}" ]]; then
                DONE_TIMES[$i]=$NOW
            fi
            JD=$(( ${DONE_TIMES[$i]} - START_EPOCH ))
            TSTR=" \033[2m(${JD}s)\033[0m"
        fi

        TOTAL_PCT=$(( TOTAL_PCT + PCT ))
        BAR=$(draw_bar "$PCT")
        printf "\033[2K  \033[1mJob %d\033[0m [\033[0;33m%s\033[0m] [%b] %3d%% — ports %-15s%b\n" \
          "$JN" "$BAR" "$STATUS" "$PCT" "$RANGE" "$TSTR"
    done

    OVERALL=$(( TOTAL_PCT / 4 ))
    OBAR=$(draw_bar "$OVERALL")

    ETA_STR="calculating..."
    if [[ $OVERALL -gt 0 && $OVERALL -lt 100 && $ELAPSED_S -gt 0 ]]; then
        ETA_S=$(( ELAPSED_S * (100 - OVERALL) / OVERALL ))
        ETA_STR=$(printf "%02dm%02ds" $(( ETA_S/60 )) $(( ETA_S%60 )))
    elif [[ $OVERALL -eq 100 ]]; then
        ETA_STR="done"
    fi

    printf "\033[2K\n"
    printf "\033[2K  \033[1mOverall: [\033[0;32m%s\033[0m] %3d%% | Elapsed: %s | ETA: %s\033[0m\n" \
      "$OBAR" "$OVERALL" "$(elapsed)" "$ETA_STR"

    [[ $ALL_DONE -eq 1 ]] && break
    sleep 3
done

wait $PID1 $PID2 $PID3 $PID4
echo -e "\n${GREEN}[+] All parallel jobs complete${NC}\n"

# ── Extract open ports ────────────────────────
echo -e "${YELLOW}[*] Extracting results...${NC}"

grep "^[0-9]" "$OUTDIR"/udp_part*.txt 2>/dev/null | \
  grep "/open/" | grep -v "open|filtered" | \
  awk -F'[:/]' '{print $2}' | sort -nu > "$OPEN_PORTS_FILE"

OPEN_FILTERED_FILE="$OUTDIR/udp_open_filtered_ports.txt"
grep "^[0-9]" "$OUTDIR"/udp_part*.txt 2>/dev/null | \
  grep "open|filtered" | \
  awk -F'[:/]' '{print $2}' | sort -nu > "$OPEN_FILTERED_FILE"

OPEN_COUNT=$(wc -l < "$OPEN_PORTS_FILE")
OPEN_FILTERED_COUNT=$(wc -l < "$OPEN_FILTERED_FILE")
OPEN_LIST=$(paste -sd',' "$OPEN_PORTS_FILE")
OPEN_FILTERED_LIST=$(paste -sd',' "$OPEN_FILTERED_FILE")

echo -e "${GREEN}[+] Confirmed open     : $OPEN_COUNT ports — ${OPEN_LIST:-none}${NC}"
echo -e "${YELLOW}[+] Open|filtered      : $OPEN_FILTERED_COUNT ports${NC}\n"

# ── Phase 3: Deep scan ────────────────────────
DEEP_PORTS=""
[[ -n "$OPEN_LIST" ]] && DEEP_PORTS="$OPEN_LIST"
[[ -n "$OPEN_LIST" && -n "$OPEN_FILTERED_LIST" ]] && DEEP_PORTS="${OPEN_LIST},${OPEN_FILTERED_LIST}"
[[ -z "$OPEN_LIST" && -n "$OPEN_FILTERED_LIST" ]] && DEEP_PORTS="$OPEN_FILTERED_LIST"

if [[ -n "$DEEP_PORTS" ]]; then
    echo -e "${YELLOW}${BOLD}[*] Phase 3 — Deep service detection${NC}"
    P3_START=$(date +%s)
    nmap -sU -sV -Pn -T4 -v \
      --version-intensity 7 --max-retries 2 \
      -p "$DEEP_PORTS" \
      --script banner,snmp-info,snmp-sysdescr,ike-version,ntp-info,ntp-monlist \
      "$TARGET" -oN "$OUTDIR/udp_deep_scan.txt" \
      > "$PROGRESS_DIR/log_deep.txt" 2>&1 &
    P3_PID=$!

    while kill -0 "$P3_PID" 2>/dev/null; do
        RAW=$(grep -oP 'About \K[0-9.]+(?=% done)' \
          "$PROGRESS_DIR/log_deep.txt" 2>/dev/null | tail -1)
        PCT=$(printf "%.0f" "${RAW:-0}")
        BAR=$(draw_bar "$PCT")
        printf "\r  \033[0;36mDeep scan:\033[0m [\033[0;33m%s\033[0m] %3d%% | $(elapsed) elapsed   " "$BAR" "$PCT"
        sleep 2
    done
    wait "$P3_PID"
    P3_DUR=$(( $(date +%s) - P3_START ))
    printf "\r  \033[0;32m✓ Deep scan done\033[0m [\033[0;32m%s\033[0m] 100%% | %ds                 \n\n" \
      "$(draw_bar 100)" "$P3_DUR"
else
    echo -e "${RED}[!] No open UDP ports — skipping deep scan${NC}"
    echo -e "${YELLOW}    Tip: open|filtered = firewall silently dropping ICMP unreachable${NC}\n"
fi

# ── Phase 4: Protocol probes ──────────────────
echo -e "${YELLOW}${BOLD}[*] Phase 4 — Protocol-specific probes${NC}\n"

run_probe() {
    local label=$1 outfile=$2
    shift 2
    local ps
    ps=$(date +%s)
    SI=0
    nmap "$@" -oN "$outfile" > /dev/null 2>&1 &
    local pp=$!
    while kill -0 "$pp" 2>/dev/null; do
        printf "\r  \033[0;36m%s\033[0m %-28s | $(elapsed) elapsed  " "${SPIN[$SI]}" "$label"
        SI=$(( (SI+1) % 10 ))
        sleep 0.2
    done
    wait "$pp"
    local dur=$(( $(date +%s) - ps ))
    local found
    found=$(grep -c "^[0-9].*open" "$outfile" 2>/dev/null || echo 0)
    if [[ $found -gt 0 ]]; then
        printf "\r  \033[0;32m✓\033[0m %-28s \033[0;32m[%d open | %ds]\033[0m          \n" \
          "$label" "$found" "$dur"
    else
        printf "\r  \033[2m✓\033[0m %-28s \033[2m[no open | %ds]\033[0m        \n" \
          "$label" "$dur"
    fi
}

run_probe "IKE/IPSec (UDP 500/4500)" "$OUTDIR/ike_probe.txt" \
  -sU -Pn -p 500,4500 --script ike-version \
  --script-args "ike-version.aggressive=true" "$TARGET"

run_probe "SNMP (UDP 161)" "$OUTDIR/snmp_probe.txt" \
  -sU -Pn -p 161 --script snmp-info,snmp-sysdescr,snmp-interfaces "$TARGET"

run_probe "NTP (UDP 123)" "$OUTDIR/ntp_probe.txt" \
  -sU -Pn -p 123 --script ntp-info,ntp-monlist "$TARGET"

run_probe "DNS (UDP 53)" "$OUTDIR/dns_probe.txt" \
  -sU -Pn -p 53 --script dns-recursion,dns-service-discovery "$TARGET"

echo -e "\n${GREEN}[+] All probes complete${NC}\n"

# ── Merge report ──────────────────────────────
echo -e "${YELLOW}[*] Generating merged report...${NC}"
TOTAL_ELAPSED=$(( $(date +%s) - START_EPOCH ))

{
echo "════════════════════════════════════════════════════════════════"
echo "  PARALLEL UDP NMAP SCAN REPORT"
echo "  Target      : $TARGET"
echo "  Date        : $(date)"
echo "  Duration    : $(( TOTAL_ELAPSED/60 ))m $(( TOTAL_ELAPSED%60 ))s"
echo "  Tool        : parallel_udp_nmap.sh v2.1 (T1046)"
echo "════════════════════════════════════════════════════════════════"
echo ""
echo "  UDP Port States:"
echo "  open          — service responded to probe"
echo "  open|filtered — no response (firewall blocking ICMP unreachable)"
echo "  closed        — ICMP port unreachable received"
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  PHASE 1 — PRIORITY UDP PORTS"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
cat "$OUTDIR/priority_udp.txt" 2>/dev/null || echo "  No results"
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  PHASE 2 — FULL UDP SCAN SUMMARY (1-65535)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Confirmed open : $OPEN_COUNT — ${OPEN_LIST:-none}"
echo "  Open|filtered  : $OPEN_FILTERED_COUNT — ${OPEN_FILTERED_LIST:-none}"
echo ""
for i in 1 2 3 4; do
    echo "  [Part $i: ${RANGES[$((i-1))]}]"
    grep -E "^[0-9]+/udp" "$OUTDIR/udp_part${i}.txt" 2>/dev/null | \
      grep -v "open|filtered" || echo "    No confirmed open ports"
    echo ""
done
if [[ -f "$OUTDIR/udp_deep_scan.txt" ]]; then
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  PHASE 3 — DEEP SERVICE DETECTION"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
cat "$OUTDIR/udp_deep_scan.txt"
echo ""
fi
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  PHASE 4 — PROTOCOL PROBES"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  [IKE/IPSec — UDP 500/4500]"
cat "$OUTDIR/ike_probe.txt" 2>/dev/null || echo "  No results"
echo ""
echo "  [SNMP — UDP 161]"
cat "$OUTDIR/snmp_probe.txt" 2>/dev/null || echo "  No results"
echo ""
echo "  [NTP — UDP 123]"
cat "$OUTDIR/ntp_probe.txt" 2>/dev/null || echo "  No results"
echo ""
echo "  [DNS — UDP 53]"
cat "$OUTDIR/dns_probe.txt" 2>/dev/null || echo "  No results"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "  SCAN COMPLETE — $(date)"
echo "  Duration : $(( TOTAL_ELAPSED/60 ))m $(( TOTAL_ELAPSED%60 ))s"
echo "  Files in : $OUTDIR/"
echo "════════════════════════════════════════════════════════════════"
} > "$FINAL_OUT"

echo -e "${GREEN}${BOLD}"
echo "  ┌──────────────────────────────────────────────────┐"
echo "  │  Scan Complete                                   │"
printf "  │  Duration : %dm %ds%*s│\n" "$(( TOTAL_ELAPSED/60 ))" "$(( TOTAL_ELAPSED%60 ))" 33 ""
printf "  │  Report   : %-36s│\n" "$FINAL_OUT"
echo "  └──────────────────────────────────────────────────┘"
echo -e "${NC}"
